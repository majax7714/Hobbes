# Hobbes derived artifacts — regenerated by the pipeline, never committed (P1)
.hobbes/derived/

# Change-specs are per-task working records (ADR-051): approved
# artifacts, not regenerable ones — but committing unapproved plans
# would put a name on decisions never made, so they stay clone-local
# here too (the C-20 shape).
.hobbes/plans/

# Terraform state carries secrets — never read, never committed
*.tfstate
*.tfstate.*

# Go
go/bin/

# Sandbox image build artifact — the static proxy is rebuilt from source
# (sandbox/Containerfile), never committed.
sandbox/hobbes-proxy

# Python
__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node (web surface, M7)
node_modules/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Web surface build artifacts (M7, ADR-022) — the SPA is rebuilt from
# web/ and embedded into hobbes-web; only the .gitkeep placeholder that
# keeps the go:embed target present in a fresh clone is committed. The
# directory itself must be re-included first: the generic `dist/` rule
# above excludes it, and git cannot re-include a file whose directory is
# excluded.
!go/internal/web/dist/
go/internal/web/dist/*
!go/internal/web/dist/.gitkeep

secrets.txt
# SWE-bench exports (bench_fetch.py output) — data, not source
/*.jsonl
